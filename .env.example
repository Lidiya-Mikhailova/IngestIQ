# =============================================================================
# IngestIQ — Production Environment Configuration
# =============================================================================
# cp .env.example .env
# =============================================================================

#APPLICATION
LOG_LEVEL=INFO

#POSTGRESQL 16
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=5432
POSTGRES_DB=ingestiq_db
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me_in_prod

#AIRFLOW 3.1.8
AIRFLOW_UID=50000
AIRFLOW_HOME=/opt/airflow
AIRFLOW_SECRET_KEY=generate_random_32_chars
AIRFLOW__CORE__FERNET_KEY=generate_random_32_chars
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_in_prod

#STORAGE
DATA_DIR=/opt/ingestiq/data_storage

#DUCKDB
DUCKDB_PATH=/opt/ingestiq/data_storage/analytics.duckdb

#PYTHON
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
